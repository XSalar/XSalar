      "typeVersion": 1,
      "position": [-10, 350],
      "credentials": {
        "openRouterApi": {
          "id": "QRQETFV8OKUdlMLa",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
