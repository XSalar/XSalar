{
  "nodes": [
    {
      "parameters": {
        "updates": ["*", "message"]
      },
      "id": "telegram_trigger",
      "name": "Telegram Trigger1",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [-1200, 160],
      "webhookId": "replace_me",
      "credentials": {
        "telegramApi": {
          "id": "y0tUhEUTp8Mmma7d",
          "name": "Telegram account 3"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json[\"message\"] && $json[\"message\"][\"contact\"] && $json[\"message\"][\"contact\"][\"phone_number\"] ? $json[\"message\"][\"contact\"][\"phone_number\"] : \"\" }}",
              "operation": "notEqual",
              "value2": ""
            }
          ]
        }
      },
      "id": "if_contact",
      "name": "IF Contact",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [-980, 160]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger1\"].json[\"message\"][\"chat\"][\"id\"] }}",
        "text": "برای ادامه لطفاً شماره موبایل‌تون رو ارسال کنید 📱",
        "replyMarkup": "replyKeyboard",
        "replyKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "📱 ارسال شماره من",
                    "additionalFields": {
                      "request_contact": true
                    }
                  }
                ]
              }
            }
          ]
        },
        "replyKeyboardOptions": {}
      },
      "id": "send_request_contact",
      "name": "Send Request Contact",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [-980, -40],
      "credentials": {
        "telegramApi": {
          "id": "y0tUhEUTp8Mmma7d",
          "name": "Telegram account 3"
        }
      }
    },
    {
      "parameters": {
        "resource": "sheetWithinDocument",
        "operation": "append",
        "documentId": "REPLACE_WITH_SHEET_ID",
        "sheetName": "Sheet1",
        "fields": {
          "values": [
            "={{ $json[\"message\"][\"contact\"][\"first_name\"] || \"\" }}",
            "={{ $json[\"message\"][\"contact\"][\"last_name\"] || \"\" }}",
            "={{ $json[\"message\"][\"contact\"][\"phone_number\"] || \"\" }}",
            "={{ $node[\"Telegram Trigger1\"].json[\"message\"][\"from\"][\"username\"] || \"\" }}",
            "={{ $node[\"Telegram Trigger1\"].json[\"message\"][\"from\"][\"id\"] }}"
          ]
        },
        "options": {
          "valueInputMode": "RAW"
        }
      },
      "id": "save_to_sheets",
      "name": "Save To Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [-770, 160]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger1\"].json[\"message\"][\"chat\"][\"id\"] }}",
        "text": "ممنون بابت ارسال شماره 🌹\nحالا می‌تونید نماد مورد نظرتون رو برای تحلیل بفرستید.",
        "replyMarkup": "removeKeyboard",
        "removeKeyboard": {}
      },
      "id": "send_welcome",
      "name": "Send Welcome",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [-570, 160],
      "credentials": {
        "telegramApi": {
          "id": "y0tUhEUTp8Mmma7d",
          "name": "Telegram account 3"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message.text",
              "value": "={{ $json?.message?.text || \"\" }}"
            }
          ]
        },
        "options": { "dotNotation": true }
      },
      "id": "preprocess",
      "name": "PreProcessing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [-380, 160]
    },
    {
      "parameters": {
        "values": {
          "number": [
            { "name": "model_temperature", "value": 0.8 },
            { "name": "token_length", "value": 500 }
          ],
          "string": [
            {
              "name": "bot_typing",
              "value": "={{ $json?.message?.text && $json.message.text.startsWith('/image') ? \"upload_photo\" : \"typing\" }}"
            }
          ]
        }
      },
      "id": "settings",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [-190, 160]
    },
    {
      "parameters": {
        "operation": "sendChatAction",
        "chatId": "={{ $node[\"Telegram Trigger1\"].json[\"message\"][\"chat\"][\"id\"] }}",
        "action": "={{ $json.bot_typing }}"
      },
      "id": "typing",
      "name": "Send Typing action",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [-190, 320],
      "webhookId": "replace_me",
      "credentials": {
        "telegramApi": {
          "id": "y0tUhEUTp8Mmma7d",
          "name": "Telegram account 3"
        }
      }
    },
    {
