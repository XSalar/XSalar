#!/usr/sbin/nft -f
# =====================================================================
# Smart DNS node firewall (nftables)  —  default-deny inbound
# ---------------------------------------------------------------------
# Named sets `home_v4` and `admin_v4` are updated atomically at runtime
# (DDNS timer / deploy) WITHOUT reloading this whole ruleset.
# NOTE: this only flushes ITS OWN table, never the entire ruleset, so it
# will not stomp on other tables (e.g. Docker's `ip nat`).
# =====================================================================

table inet smartdns
delete table inet smartdns

table inet smartdns {

    # Allowed home source networks (DNS + TLS proxy). Managed by DDNS.
    set home_v4 {
        type ipv4_addr
        flags interval
        auto-merge
{% if home_v4_elements %}
        elements = { {{ home_v4_elements }} }
{% endif %}
    }

    # Allowed admin source networks (SSH). Static, from ADMIN_CIDRS.
    set admin_v4 {
        type ipv4_addr
        flags interval
        auto-merge
{% if admin_v4_elements %}
        elements = { {{ admin_v4_elements }} }
{% endif %}
    }

    chain input {
        type filter hook input priority 0; policy drop;

        # Fast paths
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP (needed for PMTU discovery — do not break streaming)
        ip  protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
        ip6 nexthdr ipv6-icmp accept

        # --- SSH: admin sources only ---
        ip saddr @admin_v4 tcp dport {{ ssh_port }} ct state new limit rate {{ ssh_rate }} accept

        # --- DNS (53 tcp+udp): home sources only, rate limited ---
        ip saddr @home_v4 udp dport 53 limit rate {{ dns_rate }} accept
        ip saddr @home_v4 tcp dport 53 ct state new limit rate {{ dns_rate }} accept

        # --- TLS SNI proxy (443/tcp): home sources only ---
        ip saddr @home_v4 tcp dport 443 ct state new limit rate {{ conn_rate }} accept

        # --- QUIC / HTTP3 (443/udp): reject FAST so clients fall back to
        #     HTTPS-over-TCP quickly. This node does NOT proxy QUIC. ---
        ip saddr @home_v4 udp dport 443 reject with icmp type admin-prohibited

        # Everything else: dropped by policy. Log a sampled trickle only.
        limit rate 5/minute burst 5 packets log prefix "smartdns-drop: " level info
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
