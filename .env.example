# =====================================================================
# Copy to .env and fill in. .env is gitignored — NEVER commit real values.
# These map onto ansible/inventory.ini + ansible/group_vars/all.yml.
# Nothing here is a hard secret except SSH keys (kept outside this repo).
# =====================================================================

# --- Nodes (two independent public IPv4s = real redundancy) ----------
PRIMARY_VPS_IP=            # SSH address of primary node
PRIMARY_PUBLIC_IP=        # public IPv4 the TV uses for DNS + proxy (primary)
PRIMARY_NODE_NAME=smartdns-primary

SECONDARY_VPS_IP=         # SSH address of secondary node (leave empty if none yet)
SECONDARY_PUBLIC_IP=      # public IPv4 for secondary
SECONDARY_NODE_NAME=smartdns-secondary

# --- Access ----------------------------------------------------------
SSH_USER=root
ADMIN_CIDRS=              # comma list, e.g. 203.0.113.9/32  (SSH sources)
HOME_CIDRS=               # comma list, e.g. 198.51.100.20/32 (TV/home network)
HOME_DDNS_NAME=           # optional, e.g. myhome.duckdns.org (leave empty if static)

# --- Behaviour -------------------------------------------------------
DNS_TARGET_TTL=60
DNSDIST_QPS_LIMIT=50
